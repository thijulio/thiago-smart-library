{
  "name": "thiago-smart-library",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "nx dev web",
    "dev:netlify": "pnpm build && netlify dev --filter web --offline --no-open --skip-gitignore --dir dist/apps/web --functions ../../apps/api/src/functions --framework '#static'",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "test": "nx run-many -t test --all",
    "build": "nx run-many -t build --projects=web,api",
    "test:e2e": "nx e2e web-e2e",
    "format:check": "prettier --check .",
    "governance:check": "node tools/governance/collect-evidence.mjs --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm governance:check"
  },
  "dependencies": {
    "@netlify/functions": "6.0.0",
    "@thijulio/biome-css": "0.0.2",
    "@thijulio/biome-react": "0.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@axe-core/playwright": "4.13.0",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "esbuild": "0.25.12",
    "globals": "16.5.0",
    "netlify-cli": "27.5.2",
    "nx": "23.2.1",
    "prettier": "3.7.4",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.3.1",
    "vitest": "4.0.16"
  }
}
