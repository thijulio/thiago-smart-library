{
  "name": "web",
  "sourceRoot": "apps/web/app",
  "projectType": "application",
  "tags": ["scope:web", "type:app"],
  "implicitDependencies": ["domain"],
  "targets": {
    "dev": { "command": "nuxt dev apps/web" },
    "build": {
      "command": "nuxt build apps/web",
      "inputs": ["default", { "env": "NITRO_PRESET" }],
      "outputs": ["{workspaceRoot}/dist/apps/web", "{workspaceRoot}/.netlify/functions-internal"]
    },
    "typecheck": {
      "command": "nuxt prepare apps/web && vue-tsc --noEmit -p apps/web/.nuxt/tsconfig.app.json && vue-tsc --noEmit -p apps/web/.nuxt/tsconfig.server.json && vue-tsc --noEmit -p apps/web/.nuxt/tsconfig.node.json"
    },
    "test": {
      "command": "vitest run --config apps/web/vitest.config.ts && node --test tests/nx-boundaries.spec.mjs"
    },
    "lint": { "command": "eslint apps/web/app apps/web/server apps/web/nuxt.config.ts" }
  }
}
